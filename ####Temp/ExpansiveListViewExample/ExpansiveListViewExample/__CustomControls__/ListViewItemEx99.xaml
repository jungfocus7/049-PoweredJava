<ListViewItem    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ExpansiveListViewExample.ListViewItemEx99" Padding="0,0,0,0"
    OverridesDefaultStyle="True" Cursor="Hand">
    <ListViewItem.Template>
        <ControlTemplate TargetType="ListViewItem">
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True"
                Margin="0,0,0,0" Padding="0,0,0,0" IsHitTestVisible="True" Focusable="False"
                Background="Transparent" BorderThickness="0,0,1,1" BorderBrush="Transparent" x:Name="_bdrt">
                <GridViewRowPresenter Margin="0,0,0,0" SnapsToDevicePixels="True"
                    Content="{TemplateBinding Content}" IsHitTestVisible="False" Focusable="False"/>
            </Border>
        </ControlTemplate>
    </ListViewItem.Template>
</ListViewItem>
